{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run on Android Emulator",
      "type": "android",
      "request": "launch",
      "appSrcRoot": "${workspaceFolder}/app/src/main",
      "manifestPath": "${workspaceFolder}/app/src/main/AndroidManifest.xml",
      "apkPath": "${workspaceFolder}/app/build/outputs/apk/debug/app-debug.apk",
      "preLaunchTask": "android-install",
      "package": "com.example.musicstreamingapp",
      "adbPort": 5037
    },
    {
      "name": "Build & Launch (via Tasks)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Android: Run on emulator"
    }
  ]
}